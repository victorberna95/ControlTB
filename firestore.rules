rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only requests carrying a signed-in session (anonymous sign-in from
    // the app counts) may read or write. Anyone with the project's public
    // web config could otherwise call Firestore directly; this keeps casual
    // scanners/bots out while staying invisible to real users of the app
    // (no login screen — index.html signs in anonymously on load).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
